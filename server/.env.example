# ===== Coulair API: секреты и настройки =====
# На сервере файл лежит в /opt/coulair-api/.env (права 600). Пустое значение — функция выключена.

SITE_URL=https://coulair.ru
SITE_DIR=/var/www/coulair/current
DATA_DIR=/var/lib/coulair-api
PORT=3100

# --- СДЭК (ЛК СДЭК → Интеграция → Ключи API). Пусто — тестовый контур с примерными ценами.
CDEK_ACCOUNT=
CDEK_SECURE=
# Код города отправки по справочнику СДЭК: 44 Москва, 137 Санкт-Петербург, 250 Екатеринбург, 251 Нижний Тагил
CDEK_FROM_CITY_CODE=251
# 136 Посылка склад-склад, 368 Посылка склад-постамат (от двери: 138 и 366)
CDEK_TARIFF_PVZ=136
CDEK_TARIFF_POSTAMAT=368
# Наценка к доставке, ₽
CDEK_MARKUP=0
# Фиксированная цена доставки, ₽ (0 — считать калькулятором СДЭК)
DELIVERY_FLAT_PVZ=0
DELIVERY_FLAT_POSTAMAT=0

# --- ЮKassa (ЛК ЮKassa → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек 54-ФЗ (если чеки идут через ЮKassa)
YOOKASSA_RECEIPT=0
# НДС в чеке: 1 без НДС, 4 — 20%, 11 — 5% (УСН), 12 — 7% (УСН)
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_payment

# --- Почта для писем клиентам (Яндекс: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_BCC=

# --- Telegram-бот для заявок: токен от @BotFather и id чата (несколько — через запятую)
TG_BOT_TOKEN=
TG_CHAT_ID=

CONTACT_TELEGRAM=https://t.me/coulair
SELLER=Макаренко Артем Евгеньевич, самозанятый (плательщик НПД), ИНН 662336931563

# table — своя таблица: расстояние от Нижнего Тагила × вес (TARIFF_ZONES в config.js), api — калькулятор СДЭК по ключам
CDEK_CALC=table
